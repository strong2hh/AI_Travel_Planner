# 忽略配置文件（API密钥等敏感信息）
src/main/resources/application-iflytek.yml
src/main/resources/application.properties
**/*iflytek*.yml
**/*iflytek*.properties
**/*api-key*.yml
**/*api-key*.properties

# 但是保留示例文件（以.example结尾）
!**/*.example

# 标准Java项目忽略规则
.classpath
.project
.settings/
bin/
build/
target/

# 日志文件
*.log
logs/

# 依赖文件
*.jar
*.war
*.ear

# IDE文件
.idea/
*.iml
*.ipr
*.iws

# 系统文件
.DS_Store
Thumbs.db