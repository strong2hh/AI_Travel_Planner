<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai_travel_planner.mapper.ActivityMapper">

    <insert id="insert" parameterType="com.ai_travel_planner.entity.Activity"
            useGeneratedKeys="true"
            keyProperty="activityId"
            keyColumn="activity_id">

        INSERT INTO activity (
            user_id,          day_id, day,
            place,
            start_time,
            end_time,
            description
        ) VALUES (
                     #{userId},        #{dayId}, #{day},
                     #{place},
                     #{startTime},
                     #{endTime},
                     #{description}
                 )
    </insert>

</mapper>