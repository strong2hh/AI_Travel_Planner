<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai_travel_planner.mapper.ScheduleMapper">

    <insert id="insert" parameterType="com.ai_travel_planner.entity.Schedule"
            useGeneratedKeys="true"
            keyProperty="dayId"
            keyColumn="day_id">

        INSERT INTO schedule (theme,
            user_id,
            day
        ) VALUES (
                  #{theme},
                     #{userId},
                     #{day}
                 )
    </insert>

</mapper>